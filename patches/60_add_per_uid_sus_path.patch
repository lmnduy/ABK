+static bool susfs_sus_path_uid_is_allowed(struct inode *inode) {
+	struct st_susfs_sus_path_hlist *entry = NULL;
+	bool allowed = false;
+
+	if (!inode)
+		return false;
+
+	rcu_read_lock();
+	hash_for_each_possible_rcu(SUS_PATH_UID_HLIST, entry, node, inode->i_ino) {
+		if (entry->target_ino == inode->i_ino &&
+			entry->target_dev == inode->i_sb->s_dev &&
+			entry->allowed_uid >= 0 &&
+			(uid_t)entry->allowed_uid == current_uid().val)
+		{
+			allowed = true;
+			break;
+		}
+	}
+	rcu_read_unlock();
+	return allowed;
+}
+
+static void susfs_sus_path_uid_upsert(struct inode *inode, int allowed_uid) {
+	struct st_susfs_sus_path_hlist *entry = NULL;
+	bool found = false;
+
+	if (!inode || allowed_uid < 0)
+		return;
+
+	mutex_lock(&susfs_mutex_lock_sus_path_uid);
+	hash_for_each_possible(SUS_PATH_UID_HLIST, entry, node, inode->i_ino) {
+		if (entry->target_ino == inode->i_ino &&
+			entry->target_dev == inode->i_sb->s_dev)
+		{
+			entry->allowed_uid = allowed_uid;
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		entry = kzalloc(sizeof(struct st_susfs_sus_path_hlist), GFP_KERNEL);
+		if (!entry) {
+			SUSFS_LOGE("failed allocating sus_path uid entry\n");
+			mutex_unlock(&susfs_mutex_lock_sus_path_uid);
+			return;
+		}
+		entry->target_ino = inode->i_ino;
+		entry->target_dev = inode->i_sb->s_dev;
+		entry->allowed_uid = allowed_uid;
+		hash_add_rcu(SUS_PATH_UID_HLIST, &entry->node, entry->target_ino);
+	}
+	SUSFS_LOGI("sus_path visible-to-uid set: ino '%lu', dev '%u', allowed_uid '%d'\n",
+			inode->i_ino, inode->i_sb->s_dev, allowed_uid);
+	mutex_unlock(&susfs_mutex_lock_sus_path_uid);
 }
 
